# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Lockfiles
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# LocalLink runtime data (created automatically at startup; contains accounts and sessions)
# Seed/reference data (categories, locations, providers, demo issues) IS tracked so a fresh clone works.
data/users.json
data/requests.json
data/sessions.json

# User-uploaded issue evidence (demo evidence images are tracked)
public/uploads/issues/*
!public/uploads/issues/.gitkeep
!public/uploads/issues/ISS-DEMO-*.png
# Evidence for the two seeded citizen issues referenced in data/issues.json
!public/uploads/issues/ISSUE-1791232040319-1214.png
!public/uploads/issues/ISSUE-1791195864084-3607.png

